<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by every package published from src/. -->
  <PropertyGroup>
    <!-- Supported LTS releases only, from net8.0 onwards. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <VersionPrefix>0.2.0</VersionPrefix>
    <Authors>Vinicius</Authors>
    <Copyright>Copyright (c) Vinicius</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eovinicius/nothrow</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/eovinicius/nothrow/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>result;result-pattern;error-handling;railway;functional</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- CI sets CI=true: normalizes source paths in the PDBs. Left off locally so debugging keeps local paths. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- SourceLink ships with the SDK; these put the repository URL and commit in the .nuspec and embed generated sources. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <!-- Built into the SDK (no dependency). The baseline is the latest published version: pack fails on undeclared API breaks against it. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.2.0</PackageValidationBaselineVersion>
    <!-- The SDK's recommended code-quality rules (no package needed). Tests and benchmarks keep the default set:
         their Member_ExpectedBehavior names would trip CA1707. Deliberate exceptions use [SuppressMessage] in place. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- No reflection: safe for trimming and Native AOT. Also enables the analyzers that keep it that way. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
